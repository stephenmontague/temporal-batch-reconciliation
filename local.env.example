# Your Temporal Cloud settings, in one place. Copy this file to local.env (gitignored) and fill it in:
#
#   cp local.env.example local.env
#
# Read by:
#   - every app (basic-workflow-worker, fake-vendor, batch-processing-cli), when run from the repo root
#   - docker compose -f observability/docker-compose.yml (only the metrics key)
#   - scripts/*.sh
#
# Format: KEY=value, one per line. No quotes, no spaces around "=".
# A variable you export in the shell wins over the same line here.
# To go back to the local dev server, move this file aside (mv local.env local.env.off) and back again when you're done.
# Commenting out only SPRING_PROFILES_ACTIVE isn't enough: TEMPORAL_ADDRESS below would still point the apps at Cloud.

SPRING_PROFILES_ACTIVE=cloud

# Namespace endpoint and namespace ID, both shown on the namespace's page in the Cloud UI
TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=<namespace>.<account>

# Namespace API key: lets the workers and the CLI run workflows
TEMPORAL_API_KEY=

# Metrics API key: a service account with the Metrics Read-Only role (see METRICS.md). Only Prometheus uses it.
TEMPORAL_CLOUD_METRICS_API_KEY=

# Keep Cloud runs in their own database, apart from dev server runs
BATCH_PROCESSING_DB=data/cloud.db
